{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "habit-app",
  "compatibility_date": "2026-04-22",
  "observability": {
    "enabled": true
  },
  // The site is built from src/ on every deploy; only dist/ is published.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  }
}
